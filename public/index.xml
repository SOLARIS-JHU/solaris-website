&lt;style&gt;
.research-grid {
display: grid;
grid-template-columns: 1fr;
gap: 30px;
padding: 20px 0;
}
@media (min-width: 900px) {
.research-grid { grid-template-columns: repeat(3, 1fr); }
}
.flash-card {
background-color: transparent;
width: 100%;
height: 300px;
perspective: 1000px;
}
.flash-card-inner {
position: relative;
width: 100%;
height: 100%;
text-align: center;
transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
transform-style: preserve-3d;
cursor: pointer;
}
.flash-card:hover .flash-card-inner { transform: rotateY(180deg); }
.flash-card-front, .flash-card-back {
position: absolute;
width: 100%;
height: 100%;
-webkit-backface-visibility: hidden;
backface-visibility: hidden;
background-color: var(--solaris-bg);
border: 1px solid rgba(var(--solaris-accent-rgb), 0.55);
box-shadow: 0 0 18px rgba(var(--solaris-accent-rgb), 0.14);
border-radius: 12px;
color: var(--solaris-text);
transition: border-color 0.2s ease, box-shadow 0.2s ease;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
padding: 20px;
box-sizing: border-box;
}
.flash-card-front {
padding-bottom: 4.25rem;
}
.flash-card-front h3 {
color: var(--solaris-text);
text-transform: uppercase;
letter-spacing: 1px;
text-shadow: 0 0 9px rgba(var(--solaris-accent-rgb), 0.28);
white-space: nowrap;
word-break: normal;
overflow-wrap: normal;
hyphens: none;
}
.software-language {
position: absolute;
right: 1rem;
bottom: 1.35rem;
left: 1rem;
margin: 0;
color: var(--solaris-accent);
font-size: 0.875rem;
font-weight: bold;
line-height: 1.25;
}
.flash-card-front p,
.flash-card-back p,
.flash-card a {
word-break: normal;
overflow-wrap: normal;
hyphens: none;
}
.flash-card:hover .flash-card-front,
.flash-card:hover .flash-card-back,
.flash-card:focus-within .flash-card-front,
.flash-card:focus-within .flash-card-back {
border-color: var(--solaris-accent);
box-shadow: 0 0 28px rgba(var(--solaris-accent-rgb), 0.26);
}
.flash-card-back {
background-color: var(--solaris-bg);
transform: rotateY(180deg);
}
.flash-card a {
color: var(--solaris-accent) !important;
font-weight: bold;
text-transform: uppercase;
text-decoration: none;
transition: all 0.3s ease;
}
.flash-card a:hover {
color: var(--solaris-text) !important;
text-shadow: none;
text-decoration: underline;
}
.software-github-stats {
margin: 0.35rem 0 0;
color: var(--solaris-accent);
font-size: 0.9rem;
font-weight: 700;
letter-spacing: 0.02em;
}
&lt;/style&gt;
&lt;div class="research-grid"&gt;
&lt;div class="flash-card"&gt;
&lt;div class="flash-card-inner"&gt;
&lt;div class="flash-card-front"&gt;
&lt;h3 style="margin-bottom: 10px;"&gt;PiMPC.jl&lt;/h3&gt;
&lt;p&gt;Parallel-in-horizon, construction-free model predictive control with GPU acceleration&lt;/p&gt;</description></item><item><title>Our Team</title><link>/people.html</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>/people.html</guid><description>Researchers and students working across optimization, control, and scientific machine learning at the Solaris Lab.</description></item><item><title>Papers</title><link>/papers.html</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>/papers.html</guid><description>Publications and preprints from the Solaris Lab across optimization, control, scientific machine learning, and dynamical systems.</description></item></channel></rss>